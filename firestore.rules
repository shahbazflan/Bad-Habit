rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPhoneKey(phoneKey) {
      return phoneKey is string && phoneKey.size() >= 10 && phoneKey.size() <= 32 && phoneKey.matches('^p_[0-9]{8,15}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'phone',
          'phoneKey',
          'promoCode',
          'firstOrderDiscountUsed',
          'orderCount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'phone',
          'phoneKey',
          'displayName',
          'promoCode',
          'firstOrderDiscountUsed',
          'orderCount',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && data.phone is string
        && data.phone.size() >= 9
        && data.phone.size() <= 32
        && data.phone.matches('^\\+[1-9][0-9]{7,14}$')
        && data.phoneKey is string
        && isValidPhoneKey(data.phoneKey)
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && data.promoCode == 'BH-DETECTED'
        && data.firstOrderDiscountUsed is bool
        && data.orderCount is number
        && data.orderCount >= 0
        && data.orderCount <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPhoneRegistry(data) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'createdAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidWishlistItem(data, userId, productId) {
      return data.keys().hasAll([
          'uid',
          'productId',
          'name',
          'price',
          'image',
          'category',
          'addedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'productId',
          'name',
          'price',
          'image',
          'category',
          'addedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.productId is string
        && isValidId(data.productId)
        && data.productId == productId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.price is string
        && data.price.size() >= 1
        && data.price.size() <= 40
        && data.image is string
        && data.image.size() >= 1
        && data.image.size() <= 300
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 40
        && data.addedAt is timestamp;
    }

    // Atomic one-account-per-phone uniqueness registry (zero PII stored here)
    match /phoneRegistry/{phoneKey} {
      allow get: if isValidPhoneKey(phoneKey) && isSignedIn();
      allow list: if false;
      allow create: if isValidPhoneKey(phoneKey)
        && isVerifiedUser()
        && isValidPhoneRegistry(incoming())
        && incoming().createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/private/info).data.phoneKey == phoneKey;
      allow update: if false;
      allow delete: if isValidPhoneKey(phoneKey)
        && isVerifiedUser()
        && existing().uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/private/info).data.phoneKey != phoneKey;
    }

    // Member private PII profile (isolated document under users/{userId}/private/info)
    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && docId == 'info' && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isValidId(docId)
        && docId == 'info'
        && isVerifiedUser()
        && isOwner(userId)
        && isValidProfile(incoming(), userId)
        && incoming().firstOrderDiscountUsed == false
        && incoming().orderCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && getAfter(/databases/$(database)/documents/phoneRegistry/$(incoming().phoneKey)).data.uid == request.auth.uid;
      allow update: if isValidId(userId)
        && isValidId(docId)
        && docId == 'info'
        && isVerifiedUser()
        && isOwner(userId)
        && isValidProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().promoCode == existing().promoCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update contact details (must hold atomic lock on phoneKey)
          (incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'phoneKey', 'displayName', 'updatedAt'])
            && incoming().firstOrderDiscountUsed == existing().firstOrderDiscountUsed
            && incoming().orderCount == existing().orderCount
            && getAfter(/databases/$(database)/documents/phoneRegistry/$(incoming().phoneKey)).data.uid == request.auth.uid)
          ||
          // Action: Record completed order (terminal lock prevents un-marking firstOrderDiscountUsed)
          (incoming().diff(existing()).affectedKeys().hasOnly(['firstOrderDiscountUsed', 'orderCount', 'updatedAt'])
            && existing().firstOrderDiscountUsed == false
            && incoming().firstOrderDiscountUsed == true
            && incoming().orderCount == existing().orderCount + 1)
          ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['orderCount', 'updatedAt'])
            && existing().firstOrderDiscountUsed == true
            && incoming().firstOrderDiscountUsed == true
            && incoming().orderCount == existing().orderCount + 1)
        );
      allow delete: if false;
    }

    // Member wishlist subcollection (Master Gate checks parent profile exists)
    match /users/{userId}/wishlist/{productId} {
      allow get: if isValidId(userId) && isValidId(productId) && isOwner(userId);
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId)
        && isValidId(productId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidWishlistItem(incoming(), userId, productId)
        && incoming().addedAt == request.time
        && exists(/databases/$(database)/documents/users/$(userId)/private/info);
      allow update: if false;
      allow delete: if isValidId(userId)
        && isValidId(productId)
        && isVerifiedUser()
        && isOwner(userId);
    }

    // Connection test probe (read-only single doc, zero writes)
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
      allow list, create, update, delete: if false;
    }
  }
}
