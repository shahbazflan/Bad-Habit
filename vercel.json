{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.(js|css|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(aistudio|shirts|trousers_v2|hoodies|categories|email-thumbs|size_guides)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=604800, stale-while-revalidate=2592000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(clean_plate_1376.avif|clean_plate_1376.webp|clean_plate_800.avif|clean_plate_800.webp|clean_plate_mobile_hd.avif|clean_plate_mobile_hd.webp|clean_plate.jpg|bad_habit_transparent.webp|bad_habit_transparent_sm.webp|og-bad-habit.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=604800, stale-while-revalidate=2592000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/aistudio/IVORY_BOXY_front_png_8c2431ce",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=604800, stale-while-revalidate=2592000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=86400"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=86400"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=86400"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
